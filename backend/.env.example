# ============================================================
#  AntEx — Agente Vendedor de Café Arábico B2B
#  Copie este arquivo para .env e preencha os valores
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=antex_db
POSTGRES_USER=antex_user
POSTGRES_PASSWORD=antex_pass
DATABASE_URL=postgresql://antex_user:antex_pass@localhost:5432/antex_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development          # development | production
SECRET_KEY=troque-por-uma-chave-segura-aqui
API_PREFIX=/api/v1

# --- Webhook WhatsApp ---
# Evolution API
EVOLUTION_API_URL=https://sua-instancia.evolution-api.com
EVOLUTION_API_KEY=sua-chave-aqui
EVOLUTION_INSTANCE=seu-instancia

# Z-API (alternativa)
ZAPI_INSTANCE_ID=sua-instancia-id
ZAPI_TOKEN=seu-token-zapi
ZAPI_CLIENT_TOKEN=seu-client-token

# --- Localização da Empresa ---
LAT_EMPRESA=-16.686891
LON_EMPRESA=-49.264794

# --- Regras de Negócio (Padrão — editável pelo painel) ---
RAIO_MAXIMO_KM=300
PEDIDO_MINIMO_KG=30
PRECO_KG_FARDO_30=42.00
PRECO_KG_FARDO_50=40.00
TAXA_FRETE_KM=3.50
FRETE_GRATIS_ACIMA=3000.00
